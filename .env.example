# Local development only. Copy to .env if you need overrides.
POSTGRES_DB=devpilot
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot_local
POSTGRES_PORT=5432
REDIS_PORT=6379

DEVPILOT_ENV=development
DEVPILOT_API_ADDR=:8080
DEVPILOT_DATABASE_URL=postgres://devpilot:devpilot_local@localhost:5432/devpilot?sslmode=disable
DEVPILOT_REDIS_URL=redis://localhost:6379/0
DEVPILOT_SHUTDOWN_TIMEOUT=10s
DEVPILOT_SESSION_TTL=24h
DEVPILOT_WEB_ORIGIN=http://localhost:3000
# Disabled by default. Use values from a development GitHub App; never commit real values.
DEVPILOT_GITHUB_ENABLED=false
DEVPILOT_GITHUB_APP_ID=000000
DEVPILOT_GITHUB_CLIENT_ID=Iv1.replace-with-client-id
DEVPILOT_GITHUB_CLIENT_SECRET=replace-with-client-secret
DEVPILOT_GITHUB_APP_SLUG=your-devpilot-app
# PEM newlines may be represented as literal \n sequences.
DEVPILOT_GITHUB_PRIVATE_KEY=replace-with-pem-using-literal-backslash-n
DEVPILOT_GITHUB_WEBHOOK_SECRET=replace-with-a-local-development-secret
DEVPILOT_GITHUB_API_URL=https://api.github.com
DEVPILOT_GITHUB_OAUTH_URL=https://github.com
# Workspace runner control-plane authentication. Replace locally with 32+ random characters.
DEVPILOT_RUNNER_URL=http://127.0.0.1:8090
DEVPILOT_RUNNER_ADDR=:8090
DEVPILOT_RUNNER_SHARED_SECRET=replace-with-at-least-32-random-characters
DEVPILOT_RUNNER_TIMEOUT=6m
DEVPILOT_WORKER_POLL_INTERVAL=1s
DEVPILOT_WORKER_STALE_CLAIM=10m
DEVPILOT_WORKER_BASE_RETRY=2s
DEVPILOT_WORKER_MAX_RETRY=2m
DEVPILOT_WORKER_MAX_ATTEMPTS=5
DEVPILOT_WORKER_CONCURRENCY=2
DEVPILOT_INSPECTOR_IMAGE=devpilot-workspace-inspector:local
DEVPILOT_SANDBOX_MEMORY=768m
DEVPILOT_SANDBOX_CPUS=1
DEVPILOT_AGENT_RUNTIME_HOST=127.0.0.1
DEVPILOT_AGENT_RUNTIME_PORT=8091
DEVPILOT_AGENT_RUNTIME_LOG_LEVEL=INFO
DEVPILOT_AGENT_RUNTIME_ENVIRONMENT=development
# Repository analysis is disabled until all local values are deliberately configured.
DEVPILOT_ANALYSIS_ENABLED=false
DEVPILOT_MODEL_PROVIDER=auto
# Used only by the Python agent-runtime. Never provide this to the Go API or web app.
OPENAI_API_KEY=
DEVPILOT_OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
DEVPILOT_OPENAI_REASONING_EFFORT=medium
DEVPILOT_OLLAMA_BASE_URL=http://localhost:11434/v1
DEVPILOT_OLLAMA_ANALYSIS_MODEL=qwen3:8b
DEVPILOT_AGENT_RUNTIME_OPENAI_MODEL_TIMEOUT_SECONDS=60
DEVPILOT_AGENT_RUNTIME_OLLAMA_MODEL_TIMEOUT_SECONDS=120
# Model-visible evidence only; separate from the 512 KiB source-broker safety ceiling.
DEVPILOT_ANALYSIS_EVIDENCE_MAX_BYTES=4096
DEVPILOT_AGENT_RUNTIME_URL=http://127.0.0.1:8091
DEVPILOT_SOURCE_BROKER_URL=http://127.0.0.1:8080
DEVPILOT_AGENT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
DEVPILOT_ANALYSIS_PROMPT_VERSION=repository-analysis-v2
DEVPILOT_ANALYSIS_MAX_TURNS=10
DEVPILOT_ANALYSIS_OVERALL_TIMEOUT=5m
DEVPILOT_OLLAMA_ANALYSIS_OVERALL_TIMEOUT=10m
DEVPILOT_AGENT_RUNTIME_TIMEOUT=6m
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
DEVPILOT_INTERNAL_API_URL=http://127.0.0.1:8080
