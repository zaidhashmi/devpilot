{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.dev/contracts/agent-event.schema.json",
  "title": "AgentEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "organization_id", "task_run_id", "agent_run_id", "sequence", "type", "occurred_at", "payload"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "event_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "task_run_id": { "type": "string", "minLength": 1 },
    "agent_run_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "type": { "type": "string", "enum": ["state_changed", "progress", "tool_started", "tool_finished", "artifact_created", "approval_requested", "warning", "failure"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
