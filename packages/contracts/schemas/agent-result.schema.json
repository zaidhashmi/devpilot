{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.dev/contracts/agent-result.schema.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "organization_id", "task_run_id", "agent_run_id", "status", "completed_at", "artifacts"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "result_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "task_run_id": { "type": "string", "minLength": 1 },
    "agent_run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["succeeded", "failed", "cancelled", "timed_out"] },
    "completed_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "maxLength": 10000 },
    "failure_code": { "type": "string", "maxLength": 128 },
    "artifacts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/artifactReference" } }
  }
}
