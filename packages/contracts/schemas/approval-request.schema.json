{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpilot.dev/contracts/approval-request.schema.json",
  "title": "ApprovalRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "organization_id", "task_run_id", "gate", "target_id", "target_sha256", "requested_at", "evidence"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "request_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "task_run_id": { "type": "string", "minLength": 1 },
    "gate": { "type": "string", "enum": ["implementation", "pull_request"] },
    "target_id": { "type": "string", "minLength": 1 },
    "target_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requested_at": { "type": "string", "format": "date-time" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/artifactReference" } }
  }
}
